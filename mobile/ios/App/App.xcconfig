// App ターゲットの設定（Debug・Release 共通。#438）
// 個人の値（Team ID・自分用の Bundle ID）は、Git に入れない Local.xcconfig に書く（Local.xcconfig.example を写す）。
// Xcode の「Signing & Capabilities」で Team を選ぶと project.pbxproj に Team ID が入るので、そこでは選ばない（mobile/README.md）

// アプリの Bundle ID。Widget Extension（Widgets.xcconfig）はこの後ろに .widgets を付ける（#453）。
// 自分用に変えるときは、Local.xcconfig で PRODUCT_BUNDLE_IDENTIFIER ではなくこちらを書き換える
RW_APP_BUNDLE_IDENTIFIER = dev.studiotakumi.remotewhisper
PRODUCT_BUNDLE_IDENTIFIER = $(RW_APP_BUNDLE_IDENTIFIER)

// Debug のビルドだけ http を開けるようにするスクリプト（Build Phases の「Allow http in Debug」）が、
// できあがった Info.plist を書き換えるため、スクリプトのサンドボックスを切る
ENABLE_USER_SCRIPT_SANDBOXING = NO

// ホーム画面のウィジェットに録音中・前回の録音を出すための App Group（#454。spec/mobile.md 11.6）。
// 無料の Apple ID（Personal Team）では使えないことがあるので、既定では使わない（エンタイトルメントも付けない）。
// 使うときは Local.xcconfig に RW_APP_GROUP と RW_APP_GROUP_ENTITLEMENTS を書く（Local.xcconfig.example）。
// 使わないと、ウィジェットはいつも待機中の見た目で、前回の録音も出ない
RW_APP_GROUP =
RW_APP_GROUP_ENTITLEMENTS =
CODE_SIGN_ENTITLEMENTS = $(RW_APP_GROUP_ENTITLEMENTS)

#include? "Local.xcconfig"
