{
  "name": "remote-whisper-relay",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy:staging": "wrangler deploy --env staging",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:staging": "wrangler d1 migrations apply DB --env staging --remote",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.6",
    "@cloudflare/workers-types": "5.20261006.1",
    "oxlint": "1.81.0",
    "prettier": "3.9.9",
    "typescript": "~6.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  }
}
