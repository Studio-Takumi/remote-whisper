// クラウド版の中間サーバー（仕様書 spec/cloud.md 10 章）。環境は dev（ローカル）・staging・production（#167）
// 秘密情報（OAuth のクライアント・API トークン）はここに書かない。ローカルは .dev.vars、staging は wrangler secret
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 上の段はローカル（wrangler dev）用。デプロイは --env staging（本番の env は #167 で足す）
  "name": "remote-whisper-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "dev": { "port": 8787 },
  // 画面（web/dist）は同じオリジンで配る。run_worker_first のパスだけ Worker が答え、ほかは静的アセット
  // （画面の URL は SPA なので、ないパスは index.html を返す）
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/h/*", "/auth/*", "/me", "/me/*", "/pair/*", "/healthz"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "remote-whisper-dev",
      // ローカルだけで使う（wrangler dev と テスト）。リモートの DB はない
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // トンネルの公開ホスト名は <TUNNEL_PREFIX><ホスト ID の頭 12 文字>.<TUNNEL_DOMAIN>（#159。1 段のサブドメイン）
  "vars": { "CLOUD_ENV": "dev", "TUNNEL_DOMAIN": "studio-takumi.dev", "TUNNEL_PREFIX": "rwt-local-" },
  "env": {
    "staging": {
      "name": "remote-whisper-staging",
      "workers_dev": false,
      "preview_urls": false,
      // workers.dev は使わない（画面がクラウド版と判定しないため。10.15 節）
      "routes": [{ "pattern": "rw-dev.studio-takumi.dev", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "remote-whisper-staging",
          "database_id": "ec650d6d-b6d2-4354-99ed-41e5720d3267",
          "migrations_dir": "migrations",
        },
      ],
      "vars": { "CLOUD_ENV": "staging", "TUNNEL_DOMAIN": "studio-takumi.dev", "TUNNEL_PREFIX": "rwt-dev-" },
      // HTTP の計測（#163）。ローカルでは束縛を付けない（書かない）。
      // アカウントで Analytics Engine を有効にするまで、束縛を付けるとデプロイが断られる（code 10089）ので外してある。
      // 有効にしたら（CLOUD_TODO の 14）、次の行を戻す。束縛がなくても Worker は書かずに動く
      // "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "remote_whisper_staging" }],
    },
    // 本番（#167）。用意する手順は docs/deploy.md。D1 の ID は仮（本番を用意するときに `wrangler d1 create` の ID に替える）。
    // 仮のままだと、自動デプロイは本番に出さずに止まる（.github/workflows/deploy.yml の Check production config）
    "production": {
      "name": "remote-whisper",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "rw.studio-takumi.dev", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "remote-whisper",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "migrations",
        },
      ],
      "vars": { "CLOUD_ENV": "production", "TUNNEL_DOMAIN": "studio-takumi.dev", "TUNNEL_PREFIX": "rwt-" },
      // Analytics Engine を有効にしたら（CLOUD_TODO の 14）戻す
      // "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "remote_whisper" }],
    },
  },
}
