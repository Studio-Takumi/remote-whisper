// クラウド版の中間サーバー（仕様書 spec/cloud.md 10 章）。環境は dev（ローカル）・staging・production（#167）
// 秘密情報（OAuth のクライアント・API トークン）はここに書かない。ローカルは .dev.vars、staging・本番は wrangler secret
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 上の段はローカル（wrangler dev）用。デプロイは --env staging か --env production（docs/deploy.md）
  "name": "remote-whisper-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "dev": { "port": 8787 },
  // 画面（web/dist）は同じオリジンで配る。run_worker_first のパスだけ Worker が答え、ほかは静的アセット
  // （画面の URL は SPA なので、ないパスは index.html を返す）
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/h/*", "/auth/*", "/me", "/me/*", "/pair/*", "/healthz", "/csp-report"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "remote-whisper-dev",
      // ローカルだけで使う（wrangler dev と テスト）。リモートの DB はない
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // トンネルの公開ホスト名は <TUNNEL_PREFIX><ホスト ID の頭 12 文字（重なったら 32 文字）>.<TUNNEL_DOMAIN>（#159・#166。1 段のサブドメイン）。
  // TUNNEL_PREFIX は環境どうしで重ならないこと（名前の重なりは環境ごとの D1 でしか見えないため）
  "vars": { "CLOUD_ENV": "dev", "TUNNEL_DOMAIN": "studio-takumi.dev", "TUNNEL_PREFIX": "rwt-local-" },
  // CSP の違反の報告（/csp-report。#253）の回数の制限。接続元（IP）ごとに 1 分に 20 回まで。
  // 環境ごとに書く（上の段から引き継がれない）。namespace_id は環境どうしで重ねない（重ねると数を分け合う）
  "ratelimits": [{ "name": "CSP_REPORT_LIMITER", "namespace_id": "2531", "simple": { "limit": 20, "period": 60 } }],
  "env": {
    "staging": {
      "name": "remote-whisper-staging",
      "workers_dev": false,
      "preview_urls": false,
      // workers.dev は使わない（画面がクラウド版と判定しないため。10.15 節）
      "routes": [{ "pattern": "rw-dev.studio-takumi.dev", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "remote-whisper-staging",
          "database_id": "ec650d6d-b6d2-4354-99ed-41e5720d3267",
          "migrations_dir": "migrations",
        },
      ],
      "vars": { "CLOUD_ENV": "staging", "TUNNEL_DOMAIN": "studio-takumi.dev", "TUNNEL_PREFIX": "rwt-dev-" },
      "ratelimits": [{ "name": "CSP_REPORT_LIMITER", "namespace_id": "2532", "simple": { "limit": 20, "period": 60 } }],
      // HTTP の計測（#163）。ローカルでは束縛を付けない（書かない）。
      // アカウントで Analytics Engine が有効でないと、束縛を付けたデプロイは断られる（code 10089）
      "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "remote_whisper_staging" }],
    },
    // 本番（#167）。用意する手順は docs/deploy.md
    "production": {
      "name": "remote-whisper",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "rw.studio-takumi.dev", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "remote-whisper",
          "database_id": "b5999d3c-e1b6-42e9-b72e-98b15957be60",
          "migrations_dir": "migrations",
        },
      ],
      "vars": { "CLOUD_ENV": "production", "TUNNEL_DOMAIN": "studio-takumi.dev", "TUNNEL_PREFIX": "rwt-" },
      "ratelimits": [{ "name": "CSP_REPORT_LIMITER", "namespace_id": "2533", "simple": { "limit": 20, "period": 60 } }],
      "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "remote_whisper" }],
    },
  },
}
